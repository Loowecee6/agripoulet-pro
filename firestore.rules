rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Fonctions utilitaires ──────────────────────────────────────

    // Vérifie que l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie que l'UID correspond
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Vérifie que le document n'est pas trop volumineux (max 900 Ko pour garder de la marge)
    function isSized() {
      return request.resource.data.size() < 900000;
    }

    // Vérifie que la requête est en écriture (create ou update)
    function isWrite() {
      return request.method in ['create', 'update'];
    }

    // Vérifie que le champ est une liste
    function isList(field) {
      return field is list;
    }

    // Vérifie que le champ est un nombre
    function isNumber(field) {
      return field is number;
    }

    // Vérifie que le champ est une chaîne
    function isString(field) {
      return field is string;
    }

    // Vérifie que le champ est un booléen
    function isBool(field) {
      return field is bool;
    }

    // Vérifie que le champ est un timestamp
    function isTimestamp(field) {
      return field is timestamp;
    }

    // Vérifie que le champ est un map (objet)
    function isMap(field) {
      return field is map;
    }

    // ── Validation de schéma par collection ─────────────────────────
    // Appliquée en écriture (create/update) pour garantir l'intégrité des données

    // Production batch
    function validateProductionBatchWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'nom', 'dateMisePlace', 'nbPoussinsInitial',
        'prixAchatPoussin', 'suiviQuotidien', 'depenses', 'vaccinations', 'statut'])
        && isString(d.id) && isString(d.nom) && isString(d.dateMisePlace)
        && isNumber(d.nbPoussinsInitial) && isNumber(d.prixAchatPoussin)
        && isList(d.suiviQuotidien) && isList(d.depenses) && isList(d.vaccinations)
        && isString(d.statut) && d.statut in ['active', 'cloturee']
        && d.size() < 500000;
    }

    // Stock batch
    function validateStockBatchWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'nom', 'lettre', 'prixKg', 'coutInitial', 'poulets', 'isFinalized', 'typeOrigine'])
        && isString(d.id) && isString(d.nom) && isString(d.lettre)
        && isNumber(d.prixKg) && isNumber(d.coutInitial)
        && isList(d.poulets) && isBool(d.isFinalized)
        && isString(d.typeOrigine) && d.typeOrigine in ['PR', 'IM']
        && d.size() < 500000;
    }

    // Client
    function validateClientWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'nom', 'tel'])
        && isString(d.id) && isString(d.nom) && isString(d.tel)
        && d.size() < 10000;
    }

    // Sale
    function validateSaleWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'clientId', 'clientNom', 'pouletIds',
        'total', 'isCredit', 'isPaid', 'dateVente'])
        && isString(d.id) && isString(d.clientId) && isString(d.clientNom)
        && isList(d.pouletIds) && isNumber(d.total)
        && isBool(d.isCredit) && isBool(d.isPaid) && isString(d.dateVente)
        && d.size() < 100000;
    }

    // Reservation
    function validateReservationWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'clientId', 'clientNom', 'pouletIds',
        'dateReserve', 'statut', 'createdAt'])
        && isString(d.id) && isString(d.clientId) && isString(d.clientNom)
        && isList(d.pouletIds) && isString(d.dateReserve) && isString(d.createdAt)
        && isString(d.statut) && d.statut in ['pending', 'confirmed', 'cancelled', 'completed']
        && d.size() < 100000;
    }

    // Activity log entry
    function validateActivityLogWrite() {
      let d = request.resource.data;
      return d.keys().hasAll(['id', 'date', 'userId', 'userName', 'userRole', 'action', 'description'])
        && isString(d.id) && isString(d.date) && isString(d.userId)
        && isString(d.userName) && isString(d.userRole) && isString(d.action) && isString(d.description)
        && d.size() < 5000;
    }

    // ── Règles ─────────────────────────────────────────────────────

    // Vérifie si l'utilisateur connecté est admin ou super_admin
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // Vérifie si l'utilisateur a le droit d'écrire dans les collections partagées
    function isWriter() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'manager'];
    }

    // ── Ancien singleton sharedData (lecture seule pour migration) ──────────
    match /sharedData/{document} {
      allow read: if isAuthenticated();
      allow write: if false; // Plus utilisé depuis la migration vers collections
    }

    // ── NOUVELLES COLLECTIONS PAR TYPE D'ENTITÉ ────────────────────────────
    // Chaque entité dans son propre document (plus de limite 1 Mo, pas de contention)

    // ── COLLECTIONS PAR TYPE D'ENTITÉ (avec validation de schéma) ──

    // Production batches
    match /productionBatches/{batchId} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && validateProductionBatchWrite() && isSized();
      allow update: if isWriter() && validateProductionBatchWrite() && isSized();
      allow delete: if isWriter();
    }

    // Stock batches
    match /stockBatches/{batchId} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && validateStockBatchWrite() && isSized();
      allow update: if isWriter() && validateStockBatchWrite() && isSized();
      allow delete: if isWriter();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && validateClientWrite() && isSized();
      allow update: if isWriter() && validateClientWrite() && isSized();
      allow delete: if isWriter();
    }

    // Sales
    match /sales/{saleId} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && validateSaleWrite() && isSized();
      allow update: if isWriter() && validateSaleWrite() && isSized();
      allow delete: if isWriter();
    }

    // Reservations
    match /reservations/{reservationId} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && validateReservationWrite() && isSized();
      allow update: if isWriter() && validateReservationWrite() && isSized();
      allow delete: if isWriter();
    }

    // Settings (singleton — writer seulement, avec validation minimale)
    match /settings/{document} {
      allow read: if isAuthenticated();
      allow create, update: if isWriter()
        && isMap(request.resource.data)
        && isString(request.resource.data.adminPasswordHash)
        && request.resource.data.size() < 50000;
      allow delete: if false;
    }

    // Activity log (append-only, avec validation)
    match /activityLog/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && validateActivityLogWrite() && isSized();
      allow update: if false; // Le journal d'activité est immuable
      allow delete: if false;
    }

    // User permissions
    match /userPermissions/{document} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && isMap(request.resource.data) && request.resource.data.size() < 100000;
      allow update: if isWriter() && isMap(request.resource.data) && request.resource.data.size() < 100000;
      allow delete: if false;
    }

    // FCM config (admin seulement)
    match /fcm/{document} {
      allow read: if isAuthenticated();
      allow create: if isWriter() && request.resource.data.size() < 5000;
      allow update: if isWriter() && request.resource.data.size() < 5000;
      allow delete: if false;
    }

    // ── Document utilisateur (profil + rôle) ────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['role', 'createdAt']);
      allow update: if isOwner(userId) || isAdmin();

      // Sous-collection appData (ancienne, lecture seule pour migration)
      match /appData/{document} {
        allow read: if isOwner(userId) || isAdmin();
      }

      // Sous-collection backups (sauvegardes)
      match /backups/{documentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isSized();
        allow delete: if isOwner(userId);
        allow update: if false; // Les sauvegardes sont immutables
      }
    }

    // Collection pushQueue (pour les notifications FCM)
    match /pushQueue/{documentId} {
      allow read, write: if false; // Uniquement accessible par les Cloud Functions
    }
  }
}
